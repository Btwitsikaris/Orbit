# All settings are optional. Copy to .env: `npm start` loads it automatically.
# (Docker / hosting platforms: set these as environment variables instead.)

PORT=3000

# Where the SQLite database lives. Back this file up.
ORBIT_DB=./data/orbit.db

# Set to 1 when serving over HTTPS. Adds the Secure cookie flag and HSTS header.
# (Not needed if your proxy sends X-Forwarded-Proto: https.)
ORBIT_SECURE_COOKIES=0

# Set to 1 when Orbit sits behind exactly ONE reverse proxy / load balancer
# (Render, Railway, Fly, Caddy, nginx...). Login and sign-up limits then use the real
# visitor address instead of the proxy's. Leave 0 when exposed directly: the header can be forged.
ORBIT_TRUST_PROXY=0

# Require this code to create an account (share it with your team). Strongly recommended
# for anything reachable from the internet. Leave empty for open sign-up.
ORBIT_INVITE_CODE=

# If set, the very first account (which becomes the admin) must use this email.
# Stops a stranger from claiming admin on a fresh deploy.
ORBIT_ADMIN_EMAIL=

# Sign-ups allowed per address per hour (default 20)
ORBIT_REGISTER_LIMIT=20
